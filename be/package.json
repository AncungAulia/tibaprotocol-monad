{
  "name": "@tiba/be",
  "version": "0.1.0",
  "private": true,
  "description": "TIBA backend API: profiles, invites, places, trips, locations and reports.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json && node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "verify:chain": "tsx scripts/verify-chain.ts",
    "verify:broadcast": "tsx scripts/verify-broadcast.ts",
    "schema:bundle": "node scripts/bundle-migrations.mjs",
    "simulate:location": "tsx --env-file-if-exists=.env scripts/simulate-location.ts",
    "e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@privy-io/node": "^0.36.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tiba/sc": "workspace:*",
    "@turf/along": "^7.4.0",
    "@turf/length": "^7.4.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "viem": "^2.57.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
