# Server
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://app.tibaprotocol.xyz

# Supabase (service role key: server only, never ship to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Privy (dashboard > App settings)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: verification key from the Privy dashboard, bare base64 or PEM (skips the JWKS fetch)
PRIVY_VERIFICATION_KEY=

# Monad testnet (chain 10143)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Testnet only: owner key of TibaPool, used to call setCreditLimit when a payer is approved
ADMIN_PRIVATE_KEY=

# Email wallets start with 0 MON. The admin wallet sends each one this much MON once,
# so they can pay network fees. Set GAS_TOPUP_MON=0 to turn it off.
GAS_TOPUP_MON=0.1
GAS_TOPUP_BELOW_MON=0.02
GAS_TOPUP_ADMIN_FLOOR_MON=1

# OpenRouteService key for truck routes (falls back to a straight line when empty)
ORS_API_KEY=

# Used to build invite links: ${APP_URL}/join/{token}
APP_URL=https://app.tibaprotocol.xyz

# Demo: approve payers right away and give them this credit limit (USDC)
DEMO_AUTO_APPROVE=true
DEMO_CREDIT_LIMIT_USDC=3000

# Demo-only truck simulation; disabled by default. Restart be/ after changing this.
DEMO_LOCATION_SIMULATION=false
DEMO_TRIP_SECONDS=180
# Short-lived Privy access token for the shipment's carrier (CLI only; never commit a token).
DEMO_CARRIER_TOKEN=
