# Monad testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# REQUIRED. The only key you need: a testnet-only wallet with a few MON.
# Deploys the contracts, fills the pool, and (same key in be/.env as ADMIN_PRIVATE_KEY) grants credit limits.
PRIVATE_KEY=
# Receives 20% of each repaid spread. Defaults to the deployer when empty.
TREASURY=
# Optional: use an existing USDC instead of deploying MockUSDC
# (Circle testnet USDC: 0x534b2f3A21130d7a60830c2Df862319e593943A3)
USDC=

# Everything below is OPTIONAL. Users connect their own wallets and pick a role in the app.
# Demo wallets for stage rehearsal (Seed.s.sol): each gets DEMO_USDC, PAYER also gets CREDIT_LIMIT
PAYER=
CARRIER=
CONSIGNEE=
INVESTOR=
# When set, the investor wallet also deposits INVESTOR_DEPOSIT (needs MON for gas)
INVESTOR_PRIVATE_KEY=
INVESTOR_DEPOSIT=5000000000
CREDIT_LIMIT=3000000000
DEMO_USDC=5000000000
SEED_LIQUIDITY=20000000000
# Optional MON (wei) sent to each demo wallet, e.g. 10 MON = 10000000000000000000
DEMO_MON=0

# Upgrade.s.sol
TARGET=ShipmentManager
NEW_IMPL=
REFERENCE=
CALL_DATA=
